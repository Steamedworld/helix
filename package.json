{
  "name": "helix",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"pnpm --filter @helix/backend dev\" \"pnpm --filter @helix/frontend dev\"",
    "build": "pnpm --filter @helix/shared build && pnpm --filter @helix/backend build && pnpm --filter @helix/frontend build",
    "start": "pnpm --filter @helix/backend start",
    "test": "pnpm --filter @helix/backend test && pnpm --filter @helix/frontend test",
    "typecheck": "pnpm --filter @helix/shared typecheck && pnpm --filter @helix/backend typecheck && pnpm --filter @helix/frontend typecheck",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/parser": "^8.61.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "es5-ext"
    ]
  }
}
