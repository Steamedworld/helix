# Helix backend environment variables
# Copy this file to packages/backend/.env and fill in your values.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Base URL (federation remote direct playback) ──────────────────────────────
# The public URL of this Helix instance as seen by browsers.
# Required for federation remote direct playback to work across machines.
# If unset, stream URLs default to http://localhost:<PORT> and are only reachable
# on the local machine. Set this for LAN or internet deployments.
#
# Examples:
#   LAN:      BASE_URL=http://media-box.local:3001
#   Docker:   BASE_URL=http://192.168.1.42:3001
#   Reverse proxy (HTTPS): BASE_URL=https://helix.example.com
#
# Must be an absolute http:// or https:// URL. Trailing slashes are stripped.
# BASE_URL=

# ─── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=./data/helix.db
DATA_DIR=./data

# ─── TMDB (The Movie Database) ─────────────────────────────────────────────────
# Get your credentials at https://www.themoviedb.org/settings/api
# The app runs fully without TMDB credentials — enrichment is simply disabled.

# Preferred: Read Access Token (Bearer auth). Get it from API → Details → API Read Access Token
# TMDB_READ_ACCESS_TOKEN=

# Alternative: API Key v3 (query-param auth). Only used if READ_ACCESS_TOKEN is not set.
# TMDB_API_KEY=

# ─── Metadata enrichment ───────────────────────────────────────────────────────
# Directory where downloaded artwork is cached. Defaults to DATA_DIR/metadata_cache.
# METADATA_CACHE_DIR=./data/metadata_cache

# Set to "false" to disable automatic metadata enrichment on scan.
# METADATA_ENRICHMENT_ENABLED=true

# ─── Trusted Home background auto-sync ─────────────────────────────────────────
# Helix automatically syncs connected Trusted Home catalogs on a background interval.
# Uses incremental sync (?since) when last_sync_at is available; falls back to full sync
# if the remote does not support the ?since parameter.

# Set to "false" to disable background auto-sync entirely.
# TRUSTED_HOME_SYNC_ENABLED=true

# How often to sync all remote nodes (in milliseconds). Default: 6 hours.
# TRUSTED_HOME_SYNC_INTERVAL_MS=21600000

# Delay between each node's sync start to avoid thundering herd (in milliseconds). Default: 30 s.
# TRUSTED_HOME_SYNC_STAGGER_MS=30000

# Set to "true" to trigger a sync of all remote nodes immediately on server startup.
# TRUSTED_HOME_SYNC_ON_STARTUP=false

# ─── Tombstone retention ───────────────────────────────────────────────────────
# How many days Helix retains catalog deletion tombstones. Nodes that have not
# synced within this window will receive a full catalog sync (not incremental)
# to ensure deletions are not silently skipped. Default: 90. Minimum: 1.
# TOMBSTONE_RETENTION_DAYS=90

# ─── Integrations encryption ───────────────────────────────────────────────────
# Optional: master key for AES-256-GCM encryption of stored API keys (Radarr, Sonarr, etc.)
# If unset, a random key is auto-generated and stored in data/.helix_key on first run.
# Set this explicitly if you want deterministic key derivation (e.g. in Docker with a secret).
# HELIX_ENCRYPTION_KEY=
